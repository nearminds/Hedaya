# Copy to keystore.properties (git-ignored) and fill in before building a Play release.
# storeFile is resolved relative to the repo root; an absolute path outside the repo is
# strongly preferred so the keystore is never inside the working tree.
#
#   ./gradlew :android:bundleRelease
#
# If this file is absent the release build still succeeds but the AAB is UNSIGNED and
# Play Console will reject it.
storeFile=/absolute/path/to/hedaya-release.keystore
storePassword=
keyAlias=hedaya_key
keyPassword=
